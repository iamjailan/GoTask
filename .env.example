HTTP_ADDR=:9000
DATABASE_URL=postgres://gotask:gotask@localhost:5432/gotask?sslmode=disable
MIGRATIONS_PATH=migrations
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=GoTask <noreply@example.com>
SWAGGER_USERNAME=docs-admin
SWAGGER_PASSWORD=replace-with-a-long-random-password
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=12h
NODE_ENV=the-environment-the-app-is-running-in
